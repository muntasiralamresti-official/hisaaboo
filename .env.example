# ===============================================
# Hisaaboo - Vercel & Production Environment Variables
# ===============================================

# --- Database & Auth (Required for Backend / Vercel Serverless) ---
# Replace with your MongoDB Atlas Cloud connection string (not localhost in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hisaaboo?retryWrites=true&w=majority

# Strong secret key for signing JWT tokens
JWT_SECRET=your-super-strong-jwt-secret-key-at-least-32-characters-long

# Production frontend domain (used for CORS and cookies)
FRONTEND_URL=https://your-hisaaboo.vercel.app

# Optional: Set to production in live environment
NODE_ENV=production

# --- Frontend Configuration ---
# If backend is deployed as Vercel Serverless Function on same domain: leave this blank or /api
# If backend is hosted separately (e.g. Render/Railway): set to your backend API URL
NEXT_PUBLIC_API_URL=/api

NEXT_PUBLIC_APP_NAME=Hisaaboo
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_LANG=bn
